# Maintainer: BranchShell <contact@branchbay.dev>
pkgname=branchshell-bin
_version=1.0.6
pkgver=1.0.6
pkgrel=1
pkgdesc="SSH client and BranchBay's terminal"
arch=('x86_64' 'aarch64')
url="https://branchbay.dev/branchshell"
license=('LicenseRef-Proprietary')
depends=('dbus' 'gcc-libs' 'libxcb' 'libxkbcommon' 'libxkbcommon-x11' 'zlib')
optdepends=('vulkan-icd-loader: GPU rendering'
            'wayland: Wayland sessions')
provides=('branchshell')
conflicts=('branchshell' 'branchshell-bin' 'branchshell-beta-bin')
source_x86_64=("branch-shell-${_version}-linux-x86_64.tar.gz::https://releases.branchbay.dev/branchshell/releases/${_version}/branch-shell-${_version}-linux-x86_64.tar.gz")
source_aarch64=("branch-shell-${_version}-linux-aarch64.tar.gz::https://releases.branchbay.dev/branchshell/releases/${_version}/branch-shell-${_version}-linux-aarch64.tar.gz")
sha256sums_x86_64=('57c7d61dc7cfbad473a3ad91c520d840ffd9e27b2d8bf995e36ece984afc435f')
sha256sums_aarch64=('3c1c01e9454aa521638e9fc7aa1d095ca754ddb63f03bce83556a460be5aac25')

package() {
  cd "branch-shell-${_version}-linux-${CARCH}"
  install -Dm755 branch-shell "${pkgdir}/usr/bin/branch-shell"
  install -Dm644 branchshell.desktop "${pkgdir}/usr/share/applications/branchshell.desktop"
  local size
  for size in 32 48 128 256 512; do
    install -Dm644 "icons/hicolor/${size}x${size}/apps/branchshell.png" \
      "${pkgdir}/usr/share/icons/hicolor/${size}x${size}/apps/branchshell.png"
  done
}
